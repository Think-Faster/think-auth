# Шаблон deploy/.env — только НАСТРОЙКИ, без секретов.
# Секреты (пароли, ключ JWT) — только в Vault, контейнеры забирают их при старте.
# При выкатке: если deploy/.env нет, он создаётся из этого шаблона как есть.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080

# PostgreSQL: пользователи фиксированы — auth_user (приложение), auth_admin (миграции)
POSTGRES_HOST=tf-postgres
POSTGRES_PORT=5432
POSTGRES_DB=tf

# Redis (пароль — из Vault)
REDIS_HOST=tf-redis
REDIS_PORT=6379

Jwt__Issuer=auth-service
Jwt__Audience=api
