# Локальная разработка без Vault (VAULT_ROLE_ID не задан — vault-entrypoint.sh запускает приложение как есть).
# Скопировать в .env (он в .gitignore) и заменить CHANGE_ME тестовыми значениями.
# На стендах секреты берутся только из Vault — этот файл там не нужен.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=tf;Username=auth_user;Password=CHANGE_ME
Redis__ConnectionString=localhost:6379,password=CHANGE_ME

# Если файла нет, сервис сгенерирует ключ сам (только для локальной разработки).
Jwt__PrivateKeyPath=./keys/jwt-private.pem
Jwt__Issuer=auth-service
Jwt__Audience=api
